# NextTrack Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Django Core Settings
# =============================================================================

# Secret key for cryptographic signing. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-real-secret-key

# Set to False in production
DEBUG=True

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# PostgreSQL Database
# =============================================================================

# Database name
POSTGRES_DB=music_db

# Database user
POSTGRES_USER=music_user

# Database password -- use a strong password in production
POSTGRES_PASSWORD=change-me

# Database host (use 'db' for Docker Compose, 'localhost' for local dev)
POSTGRES_HOST=db

# Database port
POSTGRES_PORT=5432

# =============================================================================
# Redis (used by Celery task queue and Django caching)
# =============================================================================

# Full Redis URL
REDIS_URL=redis://redis:6379/0

# Redis hostname (use 'redis' for Docker Compose, 'localhost' for local dev)
REDIS_HOST=redis

# =============================================================================
# Music search provider
# =============================================================================
# Which catalogue backs live search and on-demand ingest.
#
#   deezer  (default) -- public API, no credentials of any kind required, and
#                        every result carries a 30s preview clip that the audio
#                        analyser turns into a real feature vector
#   spotify           -- needs the credentials below AND an active Spotify
#                        Premium subscription on the account that owns the app.
#                        Since Spotify's February 2026 migration, Development
#                        Mode apps without Premium get 403 on every catalogue
#                        call, including /search.

MUSIC_SEARCH_PROVIDER=deezer

# =============================================================================
# Audio analysis (feature vectors computed locally from preview clips)
# =============================================================================
# Spotify's /audio-features endpoint was deprecated on 2024-11-27 and returns
# 403 for apps without a pre-existing quota extension, so NextTrack computes
# valence/energy/danceability/acousticness/tempo itself from the 30-second
# preview clip using librosa. See catalog/audio_analysis.py.
#
# Analysis runs in Celery, off the search path. Without a worker, run it by
# hand: python manage.py analyze_audio --limit 50

AUDIO_ANALYSIS_ENABLED=True
AUDIO_ANALYSIS_ON_INGEST=True
AUDIO_ANALYSIS_BATCH_SIZE=200

# =============================================================================
# Spotify API Credentials (Optional -- only if MUSIC_SEARCH_PROVIDER=spotify)
# =============================================================================
# Register an app at https://developer.spotify.com/dashboard to get these.
#
# 1. Log in with your Spotify account (or create one)
# 2. Click "Create App"
# 3. Fill in the app details:
#    - App name: NextTrack (or any name you prefer)
#    - App description: Music recommendation engine
#    - Redirect URI: http://localhost:8000/spotify/callback/
# 4. Copy the Client ID and Client Secret from your app dashboard
#
# These are also used by the "export playlist to Spotify" feature, which is a
# user-authorised flow and unaffected by the Development Mode restrictions on
# catalogue endpoints.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# =============================================================================
# Last.fm API (Optional -- enables tag-based boosts in recommendations)
# =============================================================================
# Get an API key at https://www.last.fm/api/account/create

LASTFM_API_KEY=

# =============================================================================
# Genius API (Optional -- enables lyrics-related features)
# =============================================================================
# Get an access token at https://genius.com/api-clients

GENIUS_ACCESS_TOKEN=
